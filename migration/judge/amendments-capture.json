     "isError": false,
     "text": null,
     "structured": {
      "content": {
       "length": 48,
       "text": "héllo wörld — déjà vu ✓ plain text body\n"
      },
      "title": "",
      "url": "http://example.com/plain.txt"
     },
     "content_blocks": [
