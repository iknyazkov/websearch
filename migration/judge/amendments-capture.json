{
 "s01_tools_list": {
  "server_info": {
   "serverInfo": {
    "name": "websearch",
    "version": "v1.0.0"
   }
  },
  "responses": [
   {
    "call": "__tools_list__",
    "arguments": {},
    "normalized": {
     "tools": [
      {
       "name": "WebFetch",
       "description": "\n- Fetches content from a specified URL and processes it using an AI model\n- Takes a URL and a prompt as input\n- Fetches the URL content, converts HTML to markdown\n- Processes the content with the prompt using a small, fast model\n- Returns the model's response about the content\n- Use this tool when you need to retrieve and analyze web content\n\n### Usage notes:\n- The URL must be a fully-formed valid URL\n- HTTP URLs will be automatically upgraded to HTTPS\n- This tool is read-only and does not modify any files\n- Results may be summarized if the content is very large\n- Includes a self-cleaning 15-minute cache for faster responses when repeatedly accessing the same URL\n- For GitHub URLs, prefer using the gh CLI via Bash instead (e.g., gh pr view, gh issue view, gh api).\n\t",
       "description_has_month_year": false,
       "inputSchema": {
        "type": "object",
        "properties": {
         "url": {
          "type": "string",
          "description": "The URL to fetch content from"
         }
        },
        "required": [
         "url"
        ],
        "additionalProperties": false
       },
       "outputSchema": {
        "type": "object",
        "properties": {
         "url": {
          "type": "string",
          "description": "The URL that was fetched"
         },
         "title": {
          "type": "string",
          "description": "Title of the fetched page"
         },
         "content": {
          "type": "object",
          "properties": {
           "text": {
            "type": "string",
            "description": "The text content (typically markdown)"
           },
           "length": {
            "type": "integer",
            "description": "Character length of the text content"
           }
          },
          "description": "Processed content",
          "required": [
           "length",
           "text"
          ],
          "additionalProperties": false
         }
        },
        "required": [
         "content",
         "title",
         "url"
        ],
        "additionalProperties": false
       }
      },
      {
       "name": "WebSearch",
       "description": "\n- Allows Agent to search the web and use the results to inform responses\n- Provides up-to-date information for current events and recent data\n- Returns search result information formatted as search result blocks, including links as markdown hyperlinks\n- Use this tool for accessing information beyond Agent's knowledge cutoff\n- Searches are performed automatically within a single API call\n\nCRITICAL REQUIREMENT - You MUST follow this:\n  - After answering the user's question, you MUST include a \"Sources:\" section at the end of your response\n  - In the Sources section, list all relevant URLs from the search results as markdown hyperlinks: [Title](URL)\n  - This is MANDATORY - never skip including sources in your response\n  - Example format:\n\n    [Your answer here]\n\n    Sources:\n    - [Source Title 1](https://example.com/1)\n    - [Source Title 2](https://example.com/2)\n\nUsage notes:\n  - Domain filtering is supported to include or block specific websites\n\nIMPORTANT - Use the correct year in search queries:\n  - The current month is <MONTH-YEAR>. You MUST use this year when searching for recent information, documentation, or current events.\n  - Example: If the user asks for \"latest React docs\", search for \"React documentation\" with the current year, NOT last year\n\t",
       "description_has_month_year": true,
       "inputSchema": {
        "type": "object",
        "properties": {
         "query": {
          "type": "string",
          "description": "The search query to use"
         },
         "limit": {
          "type": "integer",
          "description": "Maximum number of results to return"
         }
        },
        "required": [
         "query"
        ],
        "additionalProperties": false
       },
       "outputSchema": {
        "type": "object",
        "properties": {
         "results": {
          "type": [
           "array",
           "null"
          ],
          "items": {
           "type": "object",
           "properties": {
            "url": {
             "type": "string",
             "description": "The URL of the search result"
            },
            "title": {
             "type": "string",
             "description": "The title of the search result"
            },
            "content": {
             "type": "string",
             "description": "Result of search"
            }
           },
           "required": [
            "content",
            "title",
            "url"
           ],
           "additionalProperties": false
          },
          "description": "Array of search hits"
         }
        },
        "required": [
         "results"
        ],
        "additionalProperties": false
       }
      }
     ]
    }
   }
  ],
  "proxy_requests": [],
  "stdio_noise": []
 },
 "s02_websearch_happy_linkup": {
  "server_info": {
   "serverInfo": {
    "name": "websearch",
    "version": "v1.0.0"
   }
  },
  "responses": [
   {
    "call": "WebSearch",
    "arguments": {
     "query": "latest AI news"
    },
    "normalized": {
     "isError": false,
     "text": null,
     "structured": {
      "results": [
       {
        "content": "First snippet text which is long enough to be interesting and present.",
        "title": "Result One Title",
        "url": "https://example.com/one/"
       },
       {
        "content": "Second result content text object wins here",
        "title": "Result Two Title",
        "url": "https://example.com/two/"
       },
       {
        "content": "Third result raw string content",
        "title": "Result Three Title",
        "url": "https://example.com/three/"
       },
       {
        "content": "Fourth snippet wins over object",
        "title": "Result Four Title",
        "url": "https://example.com/four/"
       },
       {
        "content": "Fifth snippet, content object missing text",
        "title": "Result Five Title",
        "url": "https://example.com/five/"
       },
       {
        "content": "{\"format\": \"text\", \"length\": 0}",
        "title": "Result Six Title",
        "url": "https://example.com/six/"
       }
      ]
     },
     "content_blocks": [
      "text"
     ]
    }
   }
  ],
  "proxy_requests": [
   {
    "host": "search.test",
    "method": "POST",
    "path": "/search",
    "headers": {
     "authorization": "Bearer judge-search-key",
     "content-type": "application/json",
     "user-agent": "Go-http-client/1.1"
    },
    "body": {
     "model": "judge-search-model",
     "query": "latest AI news",
     "max_results": 50
    }
   }
  ],
  "stdio_noise": []
 },
 "s06_plaintext_passthrough": {
  "server_info": {
   "serverInfo": {
    "name": "websearch",
