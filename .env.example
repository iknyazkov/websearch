# Copy to `.env` (same directory) and fill in what you have — the engine
# treats empty and missing values identically, so unused lines can stay.
# Loaded by `make mcp` via `uv run --env-file` only when `.env` exists;
# variables already exported in the environment override values here.
# Never commit `.env` (gitignored); it is also copied into the plugin's
# local install cache on plugin update — machine-local either way.

# Linkup-style cloud search API — required for the WebSearch tool
# (WebFetch works keyless with everything below unset):
WEB_SEARCH_BASE=
WEB_SEARCH_API_KEY=
WEB_SEARCH_MODEL=

# Optional: route fetches through a cloud API instead of the local fetcher:
WEB_FETCH_BASE=
WEB_FETCH_API_KEY=
WEB_FETCH_MODEL=

# Optional: proxy for the engine's HTTP client:
HTTPS_PROXY=
